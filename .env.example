# Frontend values are bundled into the client when they use the VITE_ prefix.
# Do not put database URLs, JWT secrets, service tokens, or customer data here.
VITE_API_BASE_URL=http://localhost:4000

# Backend-only values. Configure these in Render or your local .env file.
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://user:password@host:5432/radardesk
JWT_SECRET=replace-with-a-long-random-secret

# Local lab camera integration. Keep real URLs, usernames, and passwords only in your local .env
# or backend hosting environment; never put them in frontend VITE_ variables or committed mock data.
CAMERA_FEED_SOURCE=mock
CAMERA_FEEDS_JSON=[{"id":"real-camera-feed-001","customerId":"customer-training","projectId":"project-001","name":"Lab Camera Day Channel","deviceId":"eo-003","status":"online","mode":"day","fieldOfView":"Local lab area","lastFrameAt":"2026-07-02T10:30:00.000Z","streamUrl":"rtsp://user:password@camera-host/live","snapshotUrl":"http://camera-host/snapshot.jpg"}]
LOCAL_EVIDENCE_DIR=local-evidence
